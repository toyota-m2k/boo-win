<Project>
  <!-- このファイルを secrets.props にコピーして値を設定してください（secrets.props は Git 管理外）。 -->
  <!-- secrets.props が無い場合は環境変数 GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET が使われます。 -->
  <PropertyGroup>
	<GoogleClientId>YOUR_CLIENT_ID.apps.googleusercontent.com</GoogleClientId>
	<GoogleClientSecret>YOUR_CLIENT_SECRET</GoogleClientSecret>
  </PropertyGroup>
</Project>
