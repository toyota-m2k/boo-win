<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="BooWin.view.dialog.DateRangeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BooWin.view.dialog"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Date Range"
    >
    <StackPanel Orientation="Vertical" Spacing="12" MinWidth="280">
        <StackPanel Orientation="Vertical" Spacing="4">
            <CheckBox Content="Start Date"
                      IsChecked="{x:Bind StartDateEnabled.Value, Mode=TwoWay}"/>
            <CalendarDatePicker HorizontalAlignment="Stretch"
                                Date="{x:Bind StartDate.Value, Mode=TwoWay}"
                                IsEnabled="{x:Bind StartDateEnabled.Value, Mode=OneWay}"/>
        </StackPanel>
        <StackPanel Orientation="Vertical" Spacing="4">
            <CheckBox Content="End Date"
                      IsChecked="{x:Bind EndDateEnabled.Value, Mode=TwoWay}"/>
            <CalendarDatePicker HorizontalAlignment="Stretch"
                                Date="{x:Bind EndDate.Value, Mode=TwoWay}"
                                IsEnabled="{x:Bind EndDateEnabled.Value, Mode=OneWay}"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>
