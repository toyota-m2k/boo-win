<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BooWin.view.parts.ChapterRangeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BooWin.view.parts"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <!--
        UseSharedDevice=False:
        既定の共有 CanvasDevice はプロセスで1つのため、PinPウィンドウ（別UIスレッド）上の
        インスタンスとメインウィンドウ上のインスタンスが同一デバイスを取り合い、
        描画されない・ウィンドウクローズ時にネイティブクラッシュする問題が起きる。
        コントロールごとに専用デバイスを持たせて回避する。
    -->
    <canvas:CanvasControl
        x:Name="mCanvas"
        HorizontalAlignment="Stretch"
        Height="12"
        ClearColor="Transparent"
        UseSharedDevice="False"
        Draw="OnDraw"
        SizeChanged="OnSizeChanged"/>
</UserControl>
