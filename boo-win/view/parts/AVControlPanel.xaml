<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BooWin.view.parts.AVControlPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BooWin.view.parts"
    xmlns:view="using:BooWin.view"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary Source="../Converters.xaml"/>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal">
        <!-- buttons -->
            <StackPanel Orientation="Horizontal">
                <Button Content="Play" Command="{x:Bind ViewModel.PlayCommand, Mode=OneWay}" 
                        IsEnabled="{x:Bind ViewModel.MediaReady.Value, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsPlaying.Value, Mode=OneWay, Converter={StaticResource NegBoolVisibilityConverter}}"/>
                <Button Content="Pause" Command="{x:Bind ViewModel.PauseCommand, Mode=OneWay}" 
                        IsEnabled="{x:Bind ViewModel.MediaReady.Value, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsPlaying.Value, Mode=OneWay, Converter={StaticResource BoolVisibilityConverter}}"/>
                <Button Content="Prev" Command="{x:Bind ViewModel.PrevItemCommand, Mode=OneWay}" />
                <Button Content="Next" Command="{x:Bind ViewModel.NextItemCommand, Mode=OneWay}" />
                <Button Content="Next Chapter" Command="{x:Bind ViewModel.ChapterModel.NextChapterCommand, Mode=OneWay}"/>
                <Button Content="Prev Chapter" Command="{x:Bind ViewModel.ChapterModel.PrevChapterCommand, Mode=OneWay}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{x:Bind ViewModel.Editable.Value}">
                <Button Content="Add Chapter" Command="{x:Bind ViewModel.ChapterModel.AddChapterCommand, Mode=OneWay}" />
                <Button Content="Del Chapter" Command="{x:Bind ViewModel.ChapterModel.RemoveChapterCommand, Mode=OneWay}" />
                <Button Content="Skip Chapter" Command="{x:Bind ViewModel.ChapterModel.ToggleSkipChapterCommand, Mode=OneWay}" />
                <Button Content="Name Chapter" Command="{x:Bind ViewModel.ChapterModel.SetChapterLabelCommand, Mode=OneWay}" />
                <Button Content="Undo" Command="{x:Bind ViewModel.ChapterModel.UndoCommand, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.ChapterModel.CanUndo.Value, Mode=OneWay}"/>
                <Button Content="Redo" Command="{x:Bind ViewModel.ChapterModel.RedoCommand, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.ChapterModel.CanRedo.Value, Mode=OneWay}"/>
            </StackPanel>
        </StackPanel>
        <local:ChapterView
            ViewModel="{x:Bind ViewModel, Mode=OneWay}"
            Tapped="OnContainerTapped"
            IsEnabled="{x:Bind ViewModel.MediaReady.Value, Mode=OneWay}"
            ChapterContextMenuRequested="CV_ChapterContextMenu"
            ChapterSelected="CV_ChapterSelected"
            />
        <!-- Chapter Slider -->
        <local:PlayerSlider
            ViewModel="{x:Bind ViewModel, Mode=OneWay}"
            Height="50"
            x:Name="mChapterSlider" 
            Minimum="0"
            Maximum="{x:Bind view:Conv.ToDouble(ViewModel.NaturalDuration.Value), Mode=OneWay}"
            SmallChange="1000"
            LargeChange="10000"
            Value="0"
            ValueChanged="OnSliderChanged"
            PointerWheelChanged="OnSliderWheelChanged"
            DragStarted="OnSliderDragStarted"
            DragCompleted="OnSliderDragCompleted"
            IsEnabled="{x:Bind ViewModel.MediaReady.Value, Mode=OneWay}"
            />
        <Grid Margin="10,0,10,0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="AUTO"/>
            </Grid.ColumnDefinitions>
            <TextBlock 
                Grid.Column="0" 
                Text="{x:Bind ViewModel.ChapterModel.ChapterLabel.Value, Mode=OneWay}"/>
            <TextBlock Grid.Column="1">
                <Run Text="{x:Bind ViewModel.PositionString.Value, Mode=OneWay}"/>
                <Run Text=" / "/>
                <Run Text="{x:Bind ViewModel.DurationString.Value, Mode=OneWay}"/>
            </TextBlock>
        </Grid>

    </StackPanel>
</UserControl>
