<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BooWin.view.parts.AVControlPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BooWin.view.parts"
    xmlns:view="using:BooWin.view"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    RequestedTheme="Dark"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 動画上に重ねる透過アイコンボタン -->
            <Style x:Key="PanelIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="16"/>
            </Style>
            <Style x:Key="PanelIconToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
            <!-- 再生/一時停止 (主ボタン) -->
            <Style x:Key="PanelPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Width" Value="48"/>
                <Setter Property="Height" Value="48"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="24"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        Padding="12,0,12,8"
        Tapped="OnContainerTapped">
        <!-- 下から上へ薄くなるスクリム (動画を透かしつつ文字/ボタンの視認性を確保) -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#00000000" Offset="0"/>
                <GradientStop Color="#80000000" Offset="0.35"/>
                <GradientStop Color="#C0000000" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Chapters -->
        <local:ChapterView
            Grid.Row="1"
            Margin="0,-16,0,4"
            ViewModel="{x:Bind ViewModel, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.MediaReady.Value, Mode=OneWay}"
            ChapterContextMenuRequested="CV_ChapterContextMenu"
            ChapterSelected="CV_ChapterSelected"
            />
        <!-- Chapter Slider -->
        <local:PlayerSlider
            Grid.Row="0"
            ViewModel="{x:Bind ViewModel, Mode=OneWay}"
            Height="50"
            x:Name="mChapterSlider"
            Minimum="0"
            Maximum="{x:Bind view:Conv.ToDouble(ViewModel.NaturalDuration.Value), Mode=OneWay}"
            SmallChange="1000"
            LargeChange="10000"
            Value="0"
            ValueChanged="OnSliderChanged"
            PointerWheelChanged="OnSliderWheelChanged"
            DragStarted="OnSliderDragStarted"
            DragCompleted="OnSliderDragCompleted"
            IsEnabled="{x:Bind ViewModel.MediaReady.Value, Mode=OneWay}"
            />

        <!-- Toolbar -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 時間 / チャプター名 -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="4,0,0,0">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" FontFamily="Consolas">
                    <Run Text="{x:Bind ViewModel.PositionString.Value, Mode=OneWay}"/>
                    <Run Text=" / " Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <Run Text="{x:Bind ViewModel.DurationString.Value, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </TextBlock>
                <TextBlock
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    Text="{x:Bind ViewModel.ChapterModel.ChapterLabel.Value, Mode=OneWay}"/>
            </StackPanel>

            <!-- 再生コントロール -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Style="{StaticResource PanelIconButtonStyle}"
                        Command="{x:Bind ViewModel.PrevItemCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="Previous Item" AutomationProperties.Name="Previous Item">
                    <FontIcon Glyph="&#xE892;" FontSize="16"/>
                </Button>
                <Button Style="{StaticResource PanelIconButtonStyle}"
                        Command="{x:Bind ViewModel.ChapterModel.PrevChapterCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="Previous Chapter" AutomationProperties.Name="Previous Chapter">
                    <FontIcon Glyph="&#xE76B;" FontSize="16"/>
                </Button>
                <Button Style="{StaticResource PanelPlayButtonStyle}"
                        Command="{x:Bind ViewModel.PlayCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.MediaReady.Value, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsPlaying.Value, Mode=OneWay, Converter={StaticResource NegBoolVisibilityConverter}}"
                        ToolTipService.ToolTip="Play" AutomationProperties.Name="Play">
                    <FontIcon Glyph="&#xF5B0;" FontSize="20"/>
                </Button>
                <Button Style="{StaticResource PanelPlayButtonStyle}"
                        Command="{x:Bind ViewModel.PauseCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.MediaReady.Value, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsPlaying.Value, Mode=OneWay, Converter={StaticResource BoolVisibilityConverter}}"
                        ToolTipService.ToolTip="Pause" AutomationProperties.Name="Pause">
                    <FontIcon Glyph="&#xF8AE;" FontSize="20"/>
                </Button>
                <Button Style="{StaticResource PanelIconButtonStyle}"
                        Command="{x:Bind ViewModel.ChapterModel.NextChapterCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="Next Chapter" AutomationProperties.Name="Next Chapter">
                    <FontIcon Glyph="&#xE76C;" FontSize="16"/>
                </Button>
                <Button Style="{StaticResource PanelIconButtonStyle}"
                        Command="{x:Bind ViewModel.NextItemCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="Next Item" AutomationProperties.Name="Next Item">
                    <FontIcon Glyph="&#xE893;" FontSize="16"/>
                </Button>
            </StackPanel>

            <!-- チャプター編集 / ピン -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2" Visibility="{x:Bind ViewModel.ChapterEditable.Value}">
                    <Button Style="{StaticResource PanelIconButtonStyle}"
                            Command="{x:Bind ViewModel.ChapterModel.AddChapterCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="Add Chapter" AutomationProperties.Name="Add Chapter">
                        <FontIcon Glyph="&#xE710;" FontSize="16"/>
                    </Button>
                    <Button Style="{StaticResource PanelIconButtonStyle}"
                            Command="{x:Bind ViewModel.ChapterModel.RemoveChapterCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="Delete Chapter" AutomationProperties.Name="Delete Chapter">
                        <FontIcon Glyph="&#xE738;" FontSize="16"/>
                    </Button>
                    <Button Style="{StaticResource PanelIconButtonStyle}"
                            Command="{x:Bind ViewModel.ChapterModel.ToggleSkipChapterCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="Skip Chapter" AutomationProperties.Name="Skip Chapter">
                        <FontIcon Glyph="&#xED1A;" FontSize="16"/>
                    </Button>
                    <Button Style="{StaticResource PanelIconButtonStyle}"
                            Command="{x:Bind ViewModel.ChapterModel.SetChapterLabelCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="Name Chapter" AutomationProperties.Name="Name Chapter">
                        <FontIcon Glyph="&#xE8AC;" FontSize="16"/>
                    </Button>
                    <Button Style="{StaticResource PanelIconButtonStyle}"
                            Command="{x:Bind ViewModel.ChapterModel.UndoCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.ChapterModel.CanUndo.Value, Mode=OneWay}"
                            ToolTipService.ToolTip="Undo" AutomationProperties.Name="Undo">
                        <FontIcon Glyph="&#xE7A7;" FontSize="16"/>
                    </Button>
                    <Button Style="{StaticResource PanelIconButtonStyle}"
                            Command="{x:Bind ViewModel.ChapterModel.RedoCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.ChapterModel.CanRedo.Value, Mode=OneWay}"
                            ToolTipService.ToolTip="Redo" AutomationProperties.Name="Redo">
                        <FontIcon Glyph="&#xE7A6;" FontSize="16"/>
                    </Button>
                    <AppBarSeparator Padding="2,0"/>
                </StackPanel>
                <ToggleButton Style="{StaticResource PanelIconToggleButtonStyle}"
                              IsChecked="{x:Bind ViewModel.ControlPanelPinned.Value, Mode=TwoWay}"
                              ToolTipService.ToolTip="Pin Control Panel" AutomationProperties.Name="Pin Control Panel">
                    <FontIcon Glyph="&#xE718;" FontSize="16"/>
                </ToggleButton>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
