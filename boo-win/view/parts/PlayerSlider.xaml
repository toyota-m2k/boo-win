<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BooWin.view.parts.PlayerSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BooWin.view.parts"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <!--  つまみの色: 区間バー(AccentFillColorDefault)と区別するため、アクセントカラーの濃淡違いを使う  -->
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="SliderThumbFillBrush" Color="{ThemeResource SystemAccentColorDark3}" />
                <SolidColorBrush x:Key="SliderThumbStrokeBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="SliderThumbFillBrush" Color="{ThemeResource SystemAccentColorLight3}" />
                <SolidColorBrush x:Key="SliderThumbStrokeBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="HighContrast">
                <SolidColorBrush x:Key="SliderThumbFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                <SolidColorBrush x:Key="SliderThumbStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <!--  SVG(Android drawable)のpathDataをそのまま利用したThumb  -->
        <Style x:Key="SvgThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path
                                Data="M1,1L25,1L25,25L13,35L1,25L1,1Z"
                                Fill="{ThemeResource SliderThumbFillBrush}"
                                Stretch="Uniform"
                                Stroke="{ThemeResource SliderThumbStrokeBrush}"
                                StrokeLineJoin="Round"
                                StrokeThickness="1.2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Thumbを差し替えるためのSliderテンプレート  -->
        <Style x:Key="SvgThumbSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="{ThemeResource SliderTrackFill}" />
            <Setter Property="Foreground" Value="{ThemeResource SliderTrackValueFill}" />
            <Setter Property="ManipulationMode" Value="None" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="-7,0,-7,0" />
            <Setter Property="IsFocusEngagementEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.Resources>
                                <Style x:Key="SliderThumbStyle" BasedOn="{StaticResource SvgThumbStyle}" TargetType="Thumb" />
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ContentPresenter
                                x:Name="HeaderContentPresenter"
                                Grid.Row="0"
                                Margin="{ThemeResource SliderHeaderThemeMargin}"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                FontWeight="{ThemeResource SliderHeaderThemeFontWeight}"
                                Foreground="{ThemeResource SliderHeaderForeground}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />

                            <Grid
                                x:Name="SliderContainer"
                                Grid.Row="1"
                                Background="Transparent"
                                Control.IsTemplateFocusTarget="True">
                                <Grid x:Name="HorizontalTemplate" MinHeight="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="8" />
                                        <!-- 余白 -->
                                        <RowDefinition Height="20" />
                                        <!-- Thumb -->
                                        <RowDefinition Height="Auto" />
                                        <!-- Rail -->
                                        <RowDefinition Height="8" />
                                        <!-- 余白 -->
                                    </Grid.RowDefinitions>

                                    <Rectangle
                                        x:Name="HorizontalTrackRect"
                                        Grid.Row="2"
                                        Grid.ColumnSpan="3"
                                        Height="{ThemeResource SliderTrackThemeHeight}"
                                        Fill="Transparent" />
                                    <Rectangle
                                        x:Name="HorizontalDecreaseRect"
                                        Grid.Row="2"
                                        Height="{ThemeResource SliderTrackThemeHeight}"
                                        Fill="Transparent" />

                                    <local:ChapterRangeView
                                        ViewModel="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                        x:Name="ChapterRangeView"
                                        Grid.Row="2"
                                        Grid.ColumnSpan="3"
                                        VerticalAlignment="Center"
                                        Height="6"
                                        Margin="8,0,8,0"
                                    />
                                    <Thumb
                                        x:Name="HorizontalThumb"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.AccessibilityView="Raw"
                                        DataContext="{TemplateBinding Value}"
                                        FocusVisualMargin="-14,-6,-14,-6"
                                        DragStarted="OnSliderDragStarted"
                                        DragCompleted="OnSliderDragCompleted"
                                        Style="{StaticResource SliderThumbStyle}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Slider 
            Style="{StaticResource SvgThumbSliderStyle}"
            x:Name="mSlider" 
            HorizontalAlignment="Stretch" 
            IsThumbToolTipEnabled="False"
            VerticalAlignment="Top" 
            TickPlacement="None" 
            Minimum="0"
            Maximum="100"
            Value="0"
            ValueChanged="OnSliderChanged"
            PointerWheelChanged="OnSliderWheelChanged"
            Tag="{x:Bind ViewModel, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.Seekable.Value, Mode=OneWay}"
        />

    </Grid>
</UserControl>
