<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BooWin.view.parts.EditorPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BooWin.view.parts"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Converters.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ToggleRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="MinWidth" Value="64"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="RootGrid"
                                  Background="{ThemeResource ToggleButtonBackground}"
                                  BorderBrush="{ThemeResource ToggleButtonBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="4">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="StateOverlay.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="StateOverlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Opacity" Value="0.5"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{ThemeResource ToggleButtonBackgroundChecked}"/>
                                                <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource ToggleButtonBackgroundChecked}"/>
                                                <Setter Target="ContentArea.Foreground" Value="{ThemeResource ToggleButtonForegroundChecked}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked"/>
                                        <VisualState x:Name="Indeterminate"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="StateOverlay" Background="Transparent" CornerRadius="3"/>
                                <ContentPresenter x:Name="ContentArea"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  Foreground="{ThemeResource ToggleButtonForeground}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,12,8,8">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE714;" FontSize="18"/>
                <TextBlock Text="Convert Settings" Style="{StaticResource SubtitleTextBlockStyle}"/>
            </StackPanel>
            <Button
                x:Name="SaveAsDefaultButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,40,0"
                Style="{StaticResource SubtleButtonStyle}"
                Padding="8"
                ToolTipService.ToolTip="Save settings as default"
                Command="{x:Bind ViewModel.ConvertModel.SaveSettingsAsDefaultCommand, Mode=OneWay}">
                <FontIcon Glyph="&#xE74E;" FontSize="14"/>
            </Button>
            <Button 
                x:Name="HideButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{StaticResource SubtleButtonStyle}"
                Padding="8"
                ToolTipService.ToolTip="Hide"
                Command="{x:Bind ViewModel.ConvertModel.HideEditorPanelCommand, Mode=OneWay}">
                <FontIcon Glyph="&#xE89F;" FontSize="14"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0,16,0">
            <StackPanel Orientation="Vertical" Spacing="12" Margin="0,4,0,16">
                <!-- Encoder -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Encoder" Style="{StaticResource SectionHeaderStyle}"/>
                        <ToggleSwitch
                            Header="Use FFMpeg"
                            IsOn="{x:Bind ViewModel.ConvertModel.UseFFMpeg.Value, Mode=TwoWay}"/>
                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.ConvertModel.SetupFFMpegPathCommand, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                <TextBlock Text="Setup FFMpeg Path"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Video -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Video" Style="{StaticResource SectionHeaderStyle}"/>
                        <ComboBox
                            Header="Max Resolution"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.ConvertModel.ResolutionList, Mode=OneTime}"
                            SelectedItem="{x:Bind ViewModel.ConvertModel.Resolution.Value, Mode=TwoWay}"/>
                        <TextBox 
                            Header="Max Frame Rate"
                            InputScope="Number" 
                            Text="{x:Bind ViewModel.ConvertModel.MaxFrameRate.Value, Mode=TwoWay}"/>
                        <StackPanel
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.ConvertModel.UseFFMpeg.Value, Mode=OneWay, Converter={StaticResource NegBoolVisibilityConverter}}">
                            <ComboBox
                                Header="Max Bitrate"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.ConvertModel.BitRateList, Mode=OneTime}"
                                IsEditable="True"
                                TextSubmitted="OnBitRateTextSubmitted"
                                SelectedItem="{x:Bind ViewModel.ConvertModel.SelectedBitRate.Value, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.ConvertModel.AutoBitRate.Value, Mode=OneWay, Converter={StaticResource NegBoolConverter}}"/>
                            <CheckBox
                                Content="Auto Bitrate"
                                IsChecked="{x:Bind ViewModel.ConvertModel.AutoBitRate.Value, Mode=TwoWay}"/>
                            <RadioButtons
                                MaxColumns="3"
                                IsEnabled="{x:Bind ViewModel.ConvertModel.AutoBitRate.Value, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.ConvertModel.AutoQuality.Value, Mode=TwoWay, Converter={StaticResource EnumIndexConverter}}">
                                <RadioButton Style="{StaticResource ToggleRadioButtonStyle}" Content="Low"/>
                                <RadioButton Style="{StaticResource ToggleRadioButtonStyle}" Content="Std"/>
                                <RadioButton Style="{StaticResource ToggleRadioButtonStyle}" Content="High"/>
                            </RadioButtons>
                        </StackPanel>
                        <Grid
                            ColumnSpacing="8"
                            Visibility="{x:Bind ViewModel.ConvertModel.UseFFMpeg.Value, Mode=OneWay, Converter={StaticResource BoolVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Slider
                                Grid.Column="0"
                                Grid.Row="0"
                                Header="CRF"
                                Minimum="0"
                                Maximum="35"
                                StepFrequency="1"
                                SmallChange="1"
                                LargeChange="5"
                                SnapsTo="StepValues"
                                Value="{x:Bind ViewModel.ConvertModel.CRF.Value, Mode=TwoWay, Converter={StaticResource IntDoubleConverter}}"/>
                            <TextBlock
                                Grid.Column="1"
                                Grid.Row="0"
                                MinWidth="24"
                                Margin="0,0,0,8"
                                VerticalAlignment="Bottom"
                                TextAlignment="Right"
                                Text="{x:Bind ViewModel.ConvertModel.CRF.Value, Mode=OneWay}"/>
                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,0,0" Background="White" 
                                Padding="8,1,8,2" HorizontalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" Text="{x:Bind ViewModel.ConvertModel.CRFHint.Value, Mode=OneWay}" Foreground="{x:Bind ViewModel.ConvertModel.CRFHintBrush.Value, Mode=OneWay}"/>
                            </Border>
                        </Grid>
                        <ComboBox
                            Header="Codec"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.ConvertModel.CodecOptionList, Mode=OneTime}"
                            SelectedItem="{x:Bind ViewModel.ConvertModel.CodecOption.Value, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border
            Grid.Row="2"
            Padding="16"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Button
                HorizontalAlignment="Stretch"
                Height="40"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.ConvertModel.SaveAsCommand, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                    <TextBlock Text="Convert"/>
                </StackPanel>
            </Button>
        </Border>
    </Grid>
</UserControl>
