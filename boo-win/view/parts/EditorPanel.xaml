<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BooWin.view.parts.EditorPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BooWin.view.parts"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary Source="../Converters.xaml"/>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical">
        <CheckBox
            Content="Use FFMpeg"
            IsChecked="{x:Bind ViewModel.ConvertModel.UseFFMpeg.Value, Mode=TwoWay}"
            />
        <Button Content="Setup FFMpeg Path"
                Command="{x:Bind ViewModel.ConvertModel.SetupFFMpegPathCommand, Mode=OneWay}"/>
        <TextBlock Text="Resolution"/>
        <TextBox 
            InputScope="Number" 
            Text="{x:Bind ViewModel.ConvertModel.MaxLengthInPixel.Value, Mode=TwoWay}"/>
        <TextBlock Text="Max Frame Rate"/>
        <TextBox 
            InputScope="Number" 
            Text="{x:Bind ViewModel.ConvertModel.MaxFrameRate.Value, Mode=TwoWay}"/>
        <TextBlock 
            Text="Max Bitrate"
            Visibility="{x:Bind ViewModel.ConvertModel.UseFFMpeg.Value, Converter={StaticResource NegBoolVisibilityConverter}}"
            />
        <TextBox 
            InputScope="Number" 
            Text="{x:Bind ViewModel.ConvertModel.MaxBitRate.Value, Mode=TwoWay}" 
            Visibility="{x:Bind ViewModel.ConvertModel.UseFFMpeg.Value, Converter={StaticResource NegBoolVisibilityConverter}}"
            />
        <TextBlock 
            Text="CRF"
            Visibility="{x:Bind ViewModel.ConvertModel.UseFFMpeg.Value, Converter={StaticResource BoolVisibilityConverter}}"
            />
        <TextBox 
            InputScope="Number" 
            Text="{x:Bind ViewModel.ConvertModel.CRF.Value, Mode=TwoWay}" 
            Visibility="{x:Bind ViewModel.ConvertModel.UseFFMpeg.Value, Converter={StaticResource BoolVisibilityConverter}}"
            />
        <TextBlock Text="Codec"/>
        <TextBox
            Text="{x:Bind ViewModel.ConvertModel.CodecOption.Value, Mode=OneWay}"/>

        <Button
            Content="Convert"
            Command="{x:Bind ViewModel.ConvertModel.SaveAsCommand, Mode=OneWay}"/>
    </StackPanel>
</UserControl>
