<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="BooWin.view.parts.EditorPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BooWin.view.parts"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary Source="../Converters.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <Button 
                Content="Hide" 
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Command="{x:Bind ViewModel.ConvertModel.HideEditorPanelCommand, Mode=OneWay}"/>
            <CheckBox
                Content="Use FFMpeg"
                IsChecked="{x:Bind ViewModel.ConvertModel.UseFFMpeg.Value, Mode=TwoWay}"
                />
            <Button Content="Setup FFMpeg Path"
                Command="{x:Bind ViewModel.ConvertModel.SetupFFMpegPathCommand, Mode=OneWay}"/>
            <TextBlock Text="Max Resolution"/>
            <ComboBox
                ItemsSource="{x:Bind ViewModel.ConvertModel.ResolutionList, Mode=OneTime}"
                SelectedItem="{x:Bind ViewModel.ConvertModel.Resolution.Value, Mode=TwoWay}"/>
            <TextBlock Text="Max Frame Rate"/>
            <TextBox 
                InputScope="Number" 
                Text="{x:Bind ViewModel.ConvertModel.MaxFrameRate.Value, Mode=TwoWay}"/>
            <TextBlock 
                Text="Max Bitrate"
                Visibility="{x:Bind ViewModel.ConvertModel.UseFFMpeg.Value, Mode=OneWay, Converter={StaticResource NegBoolVisibilityConverter}}"
                />
            <ComboBox
                ItemsSource="{x:Bind ViewModel.ConvertModel.BitRateList, Mode=OneTime}"
                IsEditable="True"
                TextSubmitted="OnBitRateTextSubmitted"
                SelectedItem="{x:Bind ViewModel.ConvertModel.SelectedBitRate.Value, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.ConvertModel.UseFFMpeg.Value, Mode=OneWay, Converter={StaticResource NegBoolVisibilityConverter}}"
                />
            <TextBlock 
                Text="CRF"
                Visibility="{x:Bind ViewModel.ConvertModel.UseFFMpeg.Value, Mode=OneWay, Converter={StaticResource BoolVisibilityConverter}}"
                />
            <TextBox 
                InputScope="Number" 
                Text="{x:Bind ViewModel.ConvertModel.CRF.Value, Mode=TwoWay}" 
                Visibility="{x:Bind ViewModel.ConvertModel.UseFFMpeg.Value, Mode=OneWay, Converter={StaticResource BoolVisibilityConverter}}"
                />
            <TextBlock Text="Codec"/>
            <ComboBox
                ItemsSource="{x:Bind ViewModel.ConvertModel.CodecOptionList, Mode=OneTime}"
                SelectedItem="{x:Bind ViewModel.ConvertModel.CodecOption.Value, Mode=TwoWay}"/>

        </StackPanel>
        <Button
            Grid.Row="1"
            Content="Convert"
            Command="{x:Bind ViewModel.ConvertModel.SaveAsCommand, Mode=OneWay}"/>
    </Grid>
</UserControl>
