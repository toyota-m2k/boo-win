<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BooWin.view.page.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BooWin.view.page"
    xmlns:parts="using:BooWin.view.parts"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:model="using:BooWin.model"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <!-- 
        全画面モードをESCで終了するためのkey accelerator
        これを使うと、Escというツールチップが出るので、KeyboardAcceleratorPlacementMode="Hidden" で抑制する。
        -->
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked"/>
    </Page.KeyboardAccelerators>
    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="16,12"/>
            </Style>
            <Style x:Key="CardHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="FilterGroupStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="8,2,4,2"/>
            </Style>
            <Style x:Key="FilterToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="4"/>
            </Style>
            <Style x:Key="FilterCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
                <Style x:Key="ToolIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Width" Value="36"/>
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
                <Style x:Key="ToolIconToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                    <Setter Property="Width" Value="36"/>
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </ResourceDictionary>
        </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutModes">
                <VisualState x:Name="PlayerOnly">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsPlayerOnly.Value, Mode=OneWay}"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ToolbarPanel.Visibility" Value="Collapsed"/>
                        <Setter Target="PlaylistPanel.Visibility" Value="Collapsed"/>
                        <Setter Target="Splitter.Visibility" Value="Collapsed"/>
                        <Setter Target="PlayerPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="PlayerPanel.(Grid.ColumnSpan)" Value="3"/>
                        <Setter Target="PlaylistColumn.MinWidth" Value="0"/>
                        <Setter Target="PlayerColumn.MinWidth" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- filter bar -->
        <Border x:Name="ToolbarPanel" Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12,8">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>
                <ScrollViewer
                    Grid.Row="0"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="12">

                        <StackPanel 
                            Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Style="{StaticResource ToolIconButtonStyle}" Command="{x:Bind ViewModel.BackToEntryPageCommand}"
                                    ToolTipService.ToolTip="Back" AutomationProperties.Name="Back">
                                <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                            </Button>
                            <Button Style="{StaticResource ToolIconButtonStyle}" Command="{x:Bind ViewModel.ReloadListCommand}"
                                    ToolTipService.ToolTip="Back" AutomationProperties.Name="Back">
                                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                            </Button>
                            <Button Style="{StaticResource ToolIconButtonStyle}" Click="{x:Bind ViewModel.TogglePlayerOnly}"
                                    ToolTipService.ToolTip="Player Only (Esc to exit)" AutomationProperties.Name="Player Only">
                                <FontIcon Glyph="&#xE740;" FontSize="16"/>
                            </Button>
                        </StackPanel>
                        <AppBarSeparator Padding="0"/>

                        <!-- Channel -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsCategorySupported.Value, Mode=OneWay}">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.FilterModel.CategoryLabel.Value, Mode=OneWay}" Style="{StaticResource CardHeaderStyle}"/>
                            <DropDownButton Content="{x:Bind ViewModel.FilterModel.SelectedCategory.Value.Name, Mode=OneWay}" MinWidth="80" CornerRadius="4">
                                <DropDownButton.Flyout>
                                    <Flyout x:Name="categoryFlyout" Placement="BottomEdgeAlignedLeft">
                                        <ListView ItemsSource="{x:Bind ViewModel.FilterModel.CategoryList.Value, Mode=OneWay}" SelectionMode="Single" MaxHeight="400"
                                                  SelectedItem="{x:Bind ViewModel.FilterModel.SelectedCategory.Value, Mode=TwoWay}"
                                                  SelectionChanged="OnCategorySelectionChanged">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="model:ICategory">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>

                        <AppBarSeparator VerticalAlignment="Center"/>

                        <!-- Type -->
                        <Border Style="{StaticResource FilterGroupStyle}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <CheckBox Content="Type" Style="{StaticResource FilterCheckBoxStyle}"
                                          IsChecked="{x:Bind ViewModel.FilterModel.TypeFilterEnabled.Value, Mode=TwoWay}"/>
                                <StackPanel Orientation="Horizontal" Spacing="2"
                                            Visibility="{x:Bind ViewModel.FilterModel.TypeFilterEnabled.Value, Mode=OneWay}">
                                    <ToggleButton Style="{StaticResource FilterToggleStyle}" ToolTipService.ToolTip="Video"
                                                  IsChecked="{x:Bind ViewModel.FilterModel.TypeVideoChecked.Value, Mode=TwoWay}">
                                        <FontIcon Glyph="&#xE714;" FontSize="13"/>
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource FilterToggleStyle}" ToolTipService.ToolTip="Audio"
                                                  IsChecked="{x:Bind ViewModel.FilterModel.TypeAudioChecked.Value, Mode=TwoWay}">
                                        <FontIcon Glyph="&#xE8D6;" FontSize="13"/>
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource FilterToggleStyle}" ToolTipService.ToolTip="Photo"
                                                  IsChecked="{x:Bind ViewModel.FilterModel.TypePhotoChecked.Value, Mode=TwoWay}">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="13"/>
                                    </ToggleButton>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Rating -->
                        <Border Style="{StaticResource FilterGroupStyle}" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsRatingSupported.Value, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <CheckBox Content="Rating" Style="{StaticResource FilterCheckBoxStyle}"
                                          IsChecked="{x:Bind ViewModel.FilterModel.RatingFilterEnabled.Value, Mode=TwoWay}"/>
                                <StackPanel Orientation="Horizontal" Spacing="2"
                                            Visibility="{x:Bind ViewModel.FilterModel.RatingFilterEnabled.Value, Mode=OneWay}">
                                    <ToggleButton Style="{StaticResource FilterToggleStyle}" IsChecked="{x:Bind ViewModel.FilterModel.Rating1Checked.Value, Mode=TwoWay}">
                                        <FontIcon Glyph="&#xF146;" FontSize="13"/>
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource FilterToggleStyle}" IsChecked="{x:Bind ViewModel.FilterModel.Rating2Checked.Value, Mode=TwoWay}">
                                        <FontIcon Glyph="&#xF147;" FontSize="13"/>
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource FilterToggleStyle}" IsChecked="{x:Bind ViewModel.FilterModel.Rating3Checked.Value, Mode=TwoWay}">
                                        <FontIcon Glyph="&#xF148;" FontSize="13"/>
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource FilterToggleStyle}" IsChecked="{x:Bind ViewModel.FilterModel.Rating4Checked.Value, Mode=TwoWay}">
                                        <FontIcon Glyph="&#xF149;" FontSize="13"/>
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource FilterToggleStyle}" IsChecked="{x:Bind ViewModel.FilterModel.Rating5Checked.Value, Mode=TwoWay}">
                                        <FontIcon Glyph="&#xF14A;" FontSize="13"/>
                                    </ToggleButton>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Mark -->
                        <Border Style="{StaticResource FilterGroupStyle}" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsMarkSupported.Value, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <CheckBox Content="Mark" Style="{StaticResource FilterCheckBoxStyle}"
                                          IsChecked="{x:Bind ViewModel.FilterModel.MarkFilterEnabled.Value, Mode=TwoWay}"/>
                                <StackPanel Orientation="Horizontal" Spacing="2"
                                            Visibility="{x:Bind ViewModel.FilterModel.MarkFilterEnabled.Value, Mode=OneWay}">
                                    <ToggleButton Style="{StaticResource FilterToggleStyle}" IsChecked="{x:Bind ViewModel.FilterModel.Mark0Checked.Value, Mode=TwoWay}">
                                        <FontIcon Glyph="&#xE739;" FontSize="13"/>
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource FilterToggleStyle}" IsChecked="{x:Bind ViewModel.FilterModel.Mark1Checked.Value, Mode=TwoWay}">
                                        <FontIcon Glyph="&#xE734;" FontSize="13"/>
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource FilterToggleStyle}" IsChecked="{x:Bind ViewModel.FilterModel.Mark2Checked.Value, Mode=TwoWay}">
                                        <FontIcon Glyph="&#xE81B;" FontSize="13"/>
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource FilterToggleStyle}" IsChecked="{x:Bind ViewModel.FilterModel.Mark3Checked.Value, Mode=TwoWay}">
                                        <FontIcon Glyph="&#xEB51;" FontSize="13"/>
                                    </ToggleButton>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Date Range -->
                        <Button VerticalAlignment="Center" Height="32" Padding="10,0" CornerRadius="4"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnDateRangeClick"
                                Visibility="{x:Bind ViewModel.FilterModel.IsDateRangeActive.Value, Mode=OneWay}"
                                ToolTipService.ToolTip="Date Range Filter" AutomationProperties.Name="Date Range Filter">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE787;" FontSize="14"/>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                           Text="{x:Bind ViewModel.FilterModel.DateRangeLabel.Value, Mode=OneWay}"/>
                            </StackPanel>
                        </Button>
                        <Button VerticalAlignment="Center" Height="32" Padding="10,0" CornerRadius="4"
                                Click="OnDateRangeClick"
                                Visibility="{x:Bind ViewModel.FilterModel.IsDateRangeInactive.Value, Mode=OneWay}"
                                ToolTipService.ToolTip="Date Range Filter" AutomationProperties.Name="Date Range Filter">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE787;" FontSize="14"/>
                                <TextBlock VerticalAlignment="Center" Text="Date Range: Off"/>
                            </StackPanel>
                        </Button>

                        <!-- Text -->
                        <TextBox 
                        Width="200"
                        VerticalAlignment="Center"
                        PlaceholderText="Search Text"
                        Text="{x:Bind ViewModel.FilterModel.SearchText.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        />

                        <!-- Sort -->
                        <Border Style="{StaticResource FilterGroupStyle}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <CheckBox Content="Sort" Style="{StaticResource FilterCheckBoxStyle}"
                                          IsChecked="{x:Bind ViewModel.SortViewModel.IsEnabled.Value, Mode=TwoWay}"/>
                                <StackPanel Orientation="Horizontal" Spacing="2"
                                            Visibility="{x:Bind ViewModel.SortViewModel.IsEnabled.Value, Mode=OneWay}">
                                    <DropDownButton Content="{x:Bind ViewModel.SortViewModel.SortKey.Value, Mode=OneWay}" MinWidth="80" CornerRadius="4"
                                                    ToolTipService.ToolTip="Sort Key" AutomationProperties.Name="Sort Key">
                                        <DropDownButton.Flyout>
                                            <Flyout x:Name="sortKeyFlyout" Placement="BottomEdgeAlignedLeft">
                                                <ListView ItemsSource="{x:Bind ViewModel.SortViewModel.AvailableSortKeys.Value, Mode=OneWay}" SelectionMode="Single" MaxHeight="400"
                                                          SelectedItem="{x:Bind ViewModel.SortViewModel.ToSelectedItem(ViewModel.SortViewModel.SortKey.Value), Mode=TwoWay, BindBack=ViewModel.SortViewModel.SetSortKey}"
                                                          SelectionChanged="OnSortKeySelectionChanged"/>
                                            </Flyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                    <ToggleButton Style="{StaticResource FilterToggleStyle}"
                                                  IsChecked="{x:Bind ViewModel.SortViewModel.Descending.Value, Mode=TwoWay}"
                                                  ToolTipService.ToolTip="Sort Direction" AutomationProperties.Name="Sort Direction">
                                        <ToggleButton.Resources>
                                            <ResourceDictionary>
                                                <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="ToggleButtonBackground"/>
                                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ToggleButtonBackgroundPointerOver"/>
                                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="ToggleButtonBackgroundPressed"/>
                                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="ToggleButtonForeground"/>
                                                <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="ToggleButtonForegroundPointerOver"/>
                                                <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="ToggleButtonForegroundPressed"/>
                                                <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="ToggleButtonBorderBrush"/>
                                                <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="ToggleButtonBorderBrushPointerOver"/>
                                                <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="ToggleButtonBorderBrushPressed"/>
                                            </ResourceDictionary>
                                        </ToggleButton.Resources>
                                        <Grid>
                                            <FontIcon Glyph="&#xE74B;" FontSize="13"
                                                      Visibility="{x:Bind ViewModel.SortViewModel.Descending.Value, Mode=OneWay}"/>
                                            <FontIcon Glyph="&#xE74A;" FontSize="13"
                                                      Visibility="{x:Bind ViewModel.SortViewModel.Ascending.Value, Mode=OneWay}"/>
                                        </Grid>
                                    </ToggleButton>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="12,0,0,0">
                    <ToggleButton Style="{StaticResource ToolIconToggleButtonStyle}"
                                  IsChecked="{x:Bind ViewModel.SlideShow.Value, Mode=TwoWay}"
                                  RightTapped="OnSlideShowRightTapped"
                                  Holding="OnSlideShowHolding"
                                  ToolTipService.ToolTip="Slide Show" AutomationProperties.Name="Slide Show">
                        <FontIcon Glyph="&#xE786;" FontSize="16"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolIconToggleButtonStyle}"
                                  IsChecked="{x:Bind ViewModel.IsPropertiesVisible.Value, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Properties" AutomationProperties.Name="Properties">
                        <FontIcon Glyph="&#xE946;" FontSize="16"/>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>


        <!-- Playlist / Splitter / Player / Properties -->
        <Grid x:Name="BodyGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PlaylistColumn" Width="300" MinWidth="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="PlayerColumn" Width="*" MinWidth="100"/>
                <ColumnDefinition x:Name="PropertyColumn" Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Playlist -->
            <Grid x:Name="PlaylistPanel" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <ListView
                    x:Name="PlaylistView"
                    ItemsSource="{x:Bind ViewModel.ItemList.Value, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedItem.Value, Mode=TwoWay}"
                    SelectionMode="Single"
                    Padding="0,4">
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.25"/>
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.35"/>
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.45"/>
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="10,6"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="model:MediaItem">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- MediaType icon -->
                                <Border Width="32" Height="32" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        ToolTipService.ToolTip="{x:Bind MediaTypeLabel}">
                                    <FontIcon Glyph="{x:Bind MediaTypeGlyph}" FontSize="16"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind DateText}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" Padding="5,0" CornerRadius="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Visibility="{x:Bind HasDuration}">
                                            <TextBlock Text="{x:Bind DurationText}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Splitter -->
            <toolkit:GridSplitter x:Name="Splitter" Grid.Column="1"
                                  ResizeBehavior="BasedOnAlignment"
                                  ResizeDirection="Columns">
                <toolkit:GridSplitter.Template>
                    <ControlTemplate TargetType="toolkit:GridSplitter">
                        <Grid Background="Transparent">
                            <FontIcon Glyph="&#xE76F;" FontSize="14"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      IsHitTestVisible="False">
                                <FontIcon.RenderTransform>
                                    <RotateTransform Angle="90"/>
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </Grid>
                    </ControlTemplate>
                </toolkit:GridSplitter.Template>
            </toolkit:GridSplitter>

            <!-- Player -->
            <Grid x:Name="PlayerPanel" Grid.Column="2" Background="Black" Visibility="{x:Bind ViewModel.IsMediaPlayerVisible(ViewModel.SelectedItem.Value), Mode=OneWay}">
                <parts:PlayerView ViewModel="{x:Bind ViewModel.PlayerModel, Mode=OneWay}"/>
            </Grid>
            <Grid x:Name="PhotoViewer" Grid.Column="2" Background="Black" Visibility="{x:Bind ViewModel.IsPhotoViewerVisible(ViewModel.SelectedItem.Value), Mode=OneWay}">
                <parts:PhotoViewer ViewModel="{x:Bind ViewModel.PhotoViewerModel, Mode=OneWay}"/>
            </Grid>

            <Border x:Name="PropertyPanel" Grid.Column="3" Width="300"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{x:Bind ViewModel.IsPropertiesVisible.Value, Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <parts:ItemPropertyView ViewModel="{x:Bind ViewModel, Mode=OneWay}" Margin="16,12"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
