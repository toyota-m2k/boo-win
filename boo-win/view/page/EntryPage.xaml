<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BooWin.view.page.EntryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BooWin.model"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal">
            <Button Content="Add Host" Command="{x:Bind ViewModel.AddHostCommand}"/>
            <Button Content="Discover Host" Command="{x:Bind ViewModel.DiscoverHostCommand}"/>
        </StackPanel>
        <ListView
            ItemsSource="{x:Bind ViewModel.HostList}"
            SelectedItem="{x:Bind ViewModel.CurrentHost.Value, Mode=TwoWay}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Height="400"
            >
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PeerHost">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Bind DisplayLabel}" Margin="5"/>
                        <Button Content="Del" Click="OnDeleteHostClick"/>
                        <Button Content="Edit" Click="OnEditHostClick"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Content="Open Player" Command="{x:Bind ViewModel.GotoPlayerPageCommand}" IsEnabled="{x:Bind ViewModel.CanOpenPlayerPage.Value, Mode=OneWay}"/>
    </StackPanel>
</Page>
