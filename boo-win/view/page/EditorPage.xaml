<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BooWin.view.page.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BooWin.view.page"
    xmlns:parts="using:BooWin.view.parts"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary Source="../Converters.xaml"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <parts:PlayerView 
            Grid.Column="0" 
            ViewModel="{x:Bind ViewModel.PlayerModel, Mode=OneWay}"/>
        <Button 
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Content="Open" 
            VerticalAlignment="Top" HorizontalAlignment="Right"
            Command="{x:Bind ViewModel.ConvertModel.ShowEditorPanelCommand, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ConvertModel.ShowEditorPanel.Value, Mode=OneWay, Converter={StaticResource NegBoolVisibilityConverter}}"
            />
        <parts:EditorPanel 
            Grid.Column="1" 
            ViewModel="{x:Bind ViewModel, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ConvertModel.ShowEditorPanel.Value, Mode=OneWay}"
            />
    </Grid>
</Page>
