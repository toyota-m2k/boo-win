<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
	<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
	<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>BooWin</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <Version>0.1.1</Version>
    <!-- 単一インスタンス化のため、独自の Main (Program.cs) を使用する -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

    <!-- Debug: self-contained so it can run both as Package and Unpackaged -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
	    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    </PropertyGroup>
    <!-- Release: framework-dependent MSIX -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
	</PropertyGroup>
	<!-- Unpackaged (MSI 用): installer\build-msi.ps1 から -p:BooUnpackaged=true で指定 -->
	<PropertyGroup Condition="'$(BooUnpackaged)' == 'true'">
		<WindowsPackageType>None</WindowsPackageType>
	</PropertyGroup>
	<ItemGroup>
	  <Content Remove="Assets\bd.svg" />
    </ItemGroup>
    <ItemGroup>
      <None Remove="view\AVControlPanel.xaml" />
      <None Remove="view\dialog\DiscoverPeerDialog.xaml" />
      <None Remove="view\dialog\EditHostDialog.xaml" />
	  <None Remove="view\dialog\DateRangeDialog.xaml" />
      <None Remove="view\page\EditorPage.xaml" />
      <None Remove="view\page\EntryPage.xaml" />
      <None Remove="view\page\PlayerPage.xaml" />
      <None Remove="view\parts\ChapterRangeView.xaml" />
      <None Remove="view\parts\ChapterView.xaml" />
      <None Remove="view\parts\EditorPanel.xaml" />
      <None Remove="view\parts\ItemPropertyView.xaml" />
      <None Remove="view\parts\PhotoViewer.xaml" />
      <None Remove="view\parts\PlayerSlider.xaml" />
      <None Remove="view\PlayerView.xaml" />
      <None Remove="EditorWindow.xaml" />
    </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Animations" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Extensions" Version="8.2.251219" />
    <PackageReference Include="Google.Apis.Auth" Version="1.78.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="ReactiveProperty" Version="9.10.0" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>
  <Import Project="secrets.props" Condition="Exists('secrets.props')" />
  <Target Name="GenerateSecrets" BeforeTargets="XamlPreCompile;CoreCompile">
    <PropertyGroup>
      <GoogleClientId Condition="'$(GoogleClientId)'==''">$(GOOGLE_CLIENT_ID)</GoogleClientId>
      <GoogleClientSecret Condition="'$(GoogleClientSecret)'==''">$(GOOGLE_CLIENT_SECRET)</GoogleClientSecret>
      <_SecretsFile>$(IntermediateOutputPath)Secrets.g.cs</_SecretsFile>
    </PropertyGroup>
    <Warning Condition="'$(GoogleClientId)'=='' Or '$(GoogleClientSecret)'==''" Text="Google OAuth client id/secret is not set. Create secrets.props (see secrets.props.sample) or set GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET." />
    <WriteLinesToFile File="$(_SecretsFile)" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="namespace BooWin.model.google%3B;internal static class Secrets { public const string GoogleClientId = &quot;$(GoogleClientId)&quot;%3B public const string GoogleClientSecret = &quot;$(GoogleClientSecret)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(_SecretsFile)" />
      <FileWrites Include="$(_SecretsFile)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\external\win-boo-lib\Media\Media.csproj" />
    <ProjectReference Include="..\external\win-boo-lib\Server\Server.csproj" />
    <ProjectReference Include="..\external\win-boo-lib\Utils\Utils.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Page Update="view\dialog\EditSessionListDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="view\dialog\FFMpegPathDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="view\parts\EditorPanel.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="EditorWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="view\parts\PhotoViewer.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="view\parts\ItemPropertyView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="view\AVControlPanel.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="view\PlayerView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="view\parts\ChapterRangeView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="view\parts\PlayerSlider.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="view\Converters.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="view\dialog\EditHostDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="view\dialog\DateRangeDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="view\page\EditorPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="view\page\PlayerPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="view\page\EntryPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="view\dialog\DiscoverPeerDialog.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="view\parts\ChapterView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">False</PublishTrimmed>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <PackageCertificateThumbprint>91A7A284B2A3A40E709CB01DEA97AFE5AA3E4EE5</PackageCertificateThumbprint>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>False</GenerateTestArtifacts>
    <AppxBundle>Never</AppxBundle>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
  </PropertyGroup>
</Project>